// 1. Объявление переменных и математические выражения
let price = 150;
let count = 3;
let total = (price * count) + 50;

print("Итоговая сумма:");
print(total);

// 2. Сравнение и логическое значение
let has_discount = total >= 500;
print("Есть ли скидка:");
print(has_discount);

// 3. Проверка условия: сработает ветка IF
if has_discount {
    print("Результат: Скидка применена!");
} else {
    print("Результат: Скидка не положена.");
}
